# LLM mode: "fake" or "real"
LLM_MODE=fake

# Required when LLM_MODE=real
LLM_API_KEY=
LLM_API_BASE_URL=
LLM_MODEL=
LLM_PROFILE_LABEL=Default Model

# Optional. Accepted values: none, low, medium, high.
# Leave empty to use the model's default behaviour.
LLM_REASONING_EFFORT=

# Optional. Leave empty to use data/chatbot.db
DATABASE_URL=

# -- Local LLM support --------------------------------------------------------
# The local profile is only included when LOCAL_LLM_ENABLED is "true"
# (case-insensitive, whitespace allowed around the value).
# The Ollama server must be started separately by the user.
# There is no automatic fallback from local to the API profile —
# sessions created with the local profile stay local.
#
# Reasoning effort accepts the same values as LLM_REASONING_EFFORT
# (none, low, medium, high) or empty for the model's default.
#
# Uncomment and adjust for your local setup:

# LOCAL_LLM_ENABLED=false
# LOCAL_LLM_PROFILE_LABEL=Qwen3.5 4B (Local)
# LOCAL_LLM_API_KEY=ollama
# LOCAL_LLM_API_BASE_URL=http://127.0.0.1:11435/v1
# LOCAL_LLM_MODEL=qwen3.5:4b
# LOCAL_LLM_REASONING_EFFORT=none
